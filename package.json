{
  "name": "setrecord",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop DJ companion app for macOS — set planning, harmonic mixing, Pioneer CDJ-ready exports.",
  "main": "./out/main/main.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke/launch.smoke.mjs",
    "check:ffmpeg": "node scripts/check-ffmpeg-redistributable.mjs",
    "bench": "npm run bench:node",
    "bench:node": "vitest run --config vitest.bench.config.ts",
    "bench:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "bench:app": "node bench/app/run.mjs",
    "start": "electron-vite preview",
    "predev": "pkill -f 'SetRecordV2/node_modules/electron/dist' 2>/dev/null; pkill -f 'SetRecordV2/node_modules/.bin/electron-vite' 2>/dev/null; exit 0",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3,keytar,@journeyapps/sqlcipher,smart-whisper",
    "build:unpack": "npm run fetch-model && npm run build && electron-builder --dir",
    "icons": "node scripts/generate-icons.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build:mac": "npm run icons && npm run fetch-model && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@journeyapps/sqlcipher": "^6.0.0",
    "@sentry/electron": "^7.13.0",
    "@sentry/react": "^10.57.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^7.0.3",
    "fast-fuzzy": "^1.12.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "i18next": "^24.2.3",
    "keytar": "^7.9.0",
    "lib0": "^0.2.117",
    "lucide-react": "^0.474.0",
    "music-metadata": "^11.12.3",
    "node-llama-cpp": "^3.18.1",
    "qrcode": "^1.5.4",
    "react-focus-lock": "^2.13.7",
    "react-force-graph-2d": "^1.29.1",
    "react-i18next": "^15.7.4",
    "recharts": "^3.8.1",
    "tesseract.js": "^5.1.1",
    "wavesurfer.js": "^7.12.6",
    "ws": "^8.21.0",
    "xml2js": "^0.6.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "smart-whisper": "^0.8.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
